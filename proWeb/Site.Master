<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="proWeb.Site" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>libroExpress - Tu tienda de libros en línea</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="content/styles.css" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <div class="container-fluid">

            <header class="fixed-top d-flex justify-content-between align-items-center bg-light p-3">
                <div class="logo">
                    <h1>BookInk</h1>
                    <img src="content/blogo.png" alt="Logo de bookink" class="logo-img" />
                </div>
                
                <div class="row justify-content-between">
                    <div class="col">
                        <nav class="navbar navbar-expand-lg bg-body-tertiary">
                            <asp:Menu 
                                ID="Menu1" 
                                runat="server" 
                                CssClass="navbar-nav me-auto mb-2 mb-lg-0" 
                                Orientation="Horizontal"
                            >
                                <StaticMenuItemStyle CssClass="nav-item me-3" />
                                <DynamicMenuItemStyle CssClass="nav-link" />
                                <DynamicHoverStyle CssClass="nav-link active" />
                                <DynamicMenuStyle CssClass="dropdown-menu" />
                                <Items>
                                    <asp:MenuItem Text="Página Principal" NavigateUrl="mainPage.aspx" />
                                    <asp:MenuItem Text="Carrito" NavigateUrl="carrito.aspx" />
                                    <asp:MenuItem Text="Mis Pedidos" NavigateUrl="mispedidos.aspx" />
                                    <asp:MenuItem Text="Mi Cuenta">
                                        <asp:MenuItem Text="Iniciar Sesión" NavigateUrl="LogIn.aspx" />
                                        <asp:MenuItem Text="Registrarse" NavigateUrl="register.aspx" />
                                        <asp:MenuItem Text="Mis Datos" NavigateUrl="usuario.aspx" />
                                        <asp:MenuItem Text="Soy Admin" NavigateUrl="admin.aspx" />
                                    </asp:MenuItem>
                                </Items>
                            </asp:Menu>
                        </nav>
                    </div>
                    

                    <div class="col-auto"> 
                        <nav class="navbar bg-body-tertiary">
                            <form class="d-flex ms-auto" role="search"> 
                                <input 
                                    class="form-control" 
                                    type="search" 
                                    placeholder="Buscar" 
                                    aria-label="Buscar" 
                                    style="width: 60%; min-width: 400px;" 
                                />
                                <button 
                                    class="btn btn-outline-success ms-2" 
                                    type="submit"
                                >
                                    Buscar
                                </button>
                            </form>
                        </nav>
                    </div>
                </div>
            </header>

            <div class="main-content" style="padding-top: 120px; min-height: 600px;"> 
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
            </div>
            
            <footer class="d-flex justify-content-between align-items-center bg-light p-3"> 
                <div class="logo">
                    <img src="content/blogo.png" alt="Logo de libroExpress" class="logo-img" />
                    <h3>BookInk</h3>
                </div>
                <div class="social-media">
                    <h5>Our Social Media</h5>
                    <a href="https://www.instagram.com/"><img height="15" src="content/instagram.png" /></a>
                </div>
                <p>&copy; 2024 BookInk. Todos los derechos reservados.</p>
            </footer>
        </div>
    </form>
</body>
</html>
