<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="proWeb.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>libroExpress - Tu tienda de libros en línea</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="content/styles.css" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="container-fluid">
            <header>
                <div class="logo">
                    <h1>libroExpress</h1>
                    <img src="content/logo.png" alt="Logo de libroExpress" class="logo-img" />
                </div>
                <div class="row justify-content-between">
                    <div class="col">
                        <nav class="navbar navbar-expand-lg bg-body-tertiary">
                            <asp:Menu ID="Menu1" runat="server" CssClass="navbar-nav me-auto mb-2 mb-lg-0" Orientation="Horizontal">
                                <StaticMenuItemStyle CssClass="nav-item me-3" />
                                <DynamicHoverStyle CssClass="nav-link active" />
                                <DynamicMenuItemStyle CssClass="nav-link" />
                                <DynamicMenuStyle CssClass="dropdown-menu" />
                                <DynamicSelectedStyle CssClass="active" />
                                <Items>
                                    <asp:MenuItem Text="Página Principal" NavigateUrl="mainPage.aspx" />
                                    <asp:MenuItem Text="Carrito" NavigateUrl="carrito.aspx" />
                                    <asp:MenuItem Text="No sé aún" NavigateUrl="adminProducto.aspx" />
                                    <asp:MenuItem Text="Mi Cuenta">
                                        <asp:MenuItem Text="Iniciar Sesión" NavigateUrl="LogIn.aspx" />
                                        <asp:MenuItem Text="Registrarse" NavigateUrl="register.aspx" />
                                        <asp:MenuItem Text="Soy Admin" NavigateUrl="admin.aspx" />
                                    </asp:MenuItem>
                                </Items>
                            </asp:Menu>
                        </nav>
                    </div>
                    <div class="col">
                        <nav class="navbar bg-body-tertiary">
                            <form class="d-flex" role="search">
                                <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
                                <button class="btn btn-outline-success" type="submit">Search</button>
                            </form>
                        </nav>
                    </div>
                </div>
            </header>

            <div class="main-content">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
            <footer class="fixed-bottom d-flex justify-content-between align-items-center bg-light p-3">
                <div class="logo">
                    <img src="content/logo.png" alt="Logo de libroExpress" class="logo-img" />
                    <h3>libroExpress</h3>
                </div>
                <div class="social-media">
                    <h5>Our Social Media</h5>
                    <a href="https://www.instagram.com/"><img height="15" src="content/instagram.png" /></a>
                </div>
                <p>&copy; 2024 libroExpress. Todos los derechos reservados.</p>
            </footer>
        </div>
    </form>
</body>
</html>