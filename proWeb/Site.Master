<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="proWeb.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>libroExpress - Tu tienda de libros en línea</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="content/styles.css" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="container">
            <header>
                <div class="logo">
                    <h1>libroExpress</h1>
                    <img src="content/logo.png" alt="Logo de libroExpress" class="logo-img" />
                </div>
                <nav>
                    <ul>
                        <li><a href="carrito.aspx">Carrito</a></li>
                        <li><a href="LogIn.aspx">Iniciar Sesión</a></li>
                        <li><a href="register.aspx">Registrarte</a></li>
                        <!--
                        <li><a href="Contacto.aspx">Contacto</a></li>
                        -->
                    </ul>
                </nav>
            </header>
            
            <div class="main-content">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
            <footer>
                    <div class="logo">
                        <img src="content/logo.png" alt="Logo de libroExpress" class="logo-img" />
                    </div>
                <ul style="list-style:none; align-content:center">
                    <li><h5>Our Social Media</h5></li>
                    <li><a href="www.instagram.com"><img height="15" src="content/instagram.png" /></a></li>


                    <!--
                    <li><a href="PoliticaPrivacidad.aspx">Política de Privacidad</a></li>
                    <li><a href="TerminosCondiciones.aspx">Términos y Condiciones</a></li>
                    <li><a href="Contacto.aspx">Contáctanos</a></li>
                    -->
                </ul>
                 <p>&copy; 2024 libroExpress. Todos los derechos reservados.</p>
            </footer>
        </div>
    </form>
</body>
</html>



